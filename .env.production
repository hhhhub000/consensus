# 本番ビルド (vite build) に埋め込まれる Firebase 設定。
# Firebase Console > プロジェクトの設定 > 全般 > マイアプリ の値に書き換えてください。
# ※ これらは公開識別子であり秘密情報ではありません (保護は firestore.rules が担います)。
#    プレースホルダーのままデプロイすると認証・DB接続が動きません。
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME
