# Firebase プロジェクトの設定 (Firebase Console > プロジェクトの設定 > 全般 > マイアプリ)
# 未設定の場合、開発モードではローカルエミュレーター (demo-consensus) に接続します
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 名前付き Firestore データベースの ID (未設定なら honnne)
VITE_FIRESTORE_DATABASE_ID=
# エミュレーターを強制する場合は true
VITE_USE_EMULATOR=
